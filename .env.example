# PostgreSQL connection used by Prisma CLI and the server-side Prisma client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bookshop?schema=public"
# Canonical public origin and optional comma-separated trusted browser origins.
APP_ORIGIN="http://localhost:3000"
ALLOWED_CORS_ORIGINS=
# Local development authentication users
# Set a local password in .env. Never commit the real value.
DEV_TEST_USER_PASSWORD=

# Stripe PaymentIntent and signed webhook configuration.
# Never commit real secret values.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional transactional order confirmation delivery through Resend.
# Fulfilled orders remain safely queued until both values are configured.
RESEND_API_KEY=
ORDER_CONFIRMATION_FROM_EMAIL=

# Production media storage. Keep `local` for development; use `s3` for AWS S3 or Cloudflare R2.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Legal operator identity required by the production preflight.
LEGAL_BUSINESS_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_BUSINESS_ADDRESS=
