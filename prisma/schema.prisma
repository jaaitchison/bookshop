generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  READER
  WRITER
  ADMIN
}

enum BookStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum BookVisibility {
  PRIVATE
  PUBLIC
}

enum BookFileType {
  MANUSCRIPT
  SAMPLE
}

enum BookFileFormat {
  PDF
  EPUB
}

enum OrderStatus {
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum MfaMethod {
  NONE
  AUTHENTICATOR_APP
  SMS
  PASSKEY
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  username           String    @unique
  bio                String    @default("")
  avatar             String    @default("")
  location           String    @default("")
  joinedAt           DateTime  @default(now())
  goals              String[]  @default([])
  activeRole         RoleKey   @default(READER)
  onboardingComplete Boolean   @default(false)
  connectedSocials   String[]  @default([])
  mfaEnabled         Boolean   @default(false)
  mfaMethod          MfaMethod @default(NONE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles            UserRoleAssignment[]
  writerProfile    WriterProfile?
  authoredBooks    Book[]               @relation("BookAuthor")
  orders           Order[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  readingProgress  ReadingProgress[]
  sessions         AuthSession[]
  chapterRevisions ChapterRevision[]
  cart             Cart?
  libraryItems     LibraryItem[]
  paymentAttempts  PaymentAttempt[]
}

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())

  users UserRoleAssignment[]
}

model UserRoleAssignment {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model WriterProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  penName    String?
  biography  String    @default("")
  website    String?
  verified   Boolean   @default(false)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  subtitle          String         @default("")
  authorDisplayName String
  authorId          String?
  description       String         @default("")
  genre             String         @default("Fiction")
  coverUrl          String         @default("")
  price             Decimal        @default(0) @db.Decimal(10, 2)
  ratingAverage     Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount       Int            @default(0)
  featured          Boolean        @default(false)
  newRelease        Boolean        @default(false)
  status            BookStatus     @default(DRAFT)
  visibility        BookVisibility @default(PRIVATE)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  author              User?                @relation("BookAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  chapters            Chapter[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  readingProgress     ReadingProgress[]
  editions            BookEdition[]
  files               BookFile[]
  cover               BookCover?
  cartItems           CartItem[]
  libraryItems        LibraryItem[]
  paymentAttemptItems PaymentAttemptItem[]

  @@index([authorId])
  @@index([status])
  @@index([visibility])
  @@index([genre])
  @@index([featured])
}

model Chapter {
  id        String   @id @default(cuid())
  bookId    String
  title     String
  content   String
  chapterNo Int
  isPreview Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress  ReadingProgress[]
  revisions ChapterRevision[]

  @@unique([bookId, chapterNo])
  @@index([bookId])
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  status           OrderStatus @default(PROCESSING)
  total            Decimal     @db.Decimal(10, 2)
  currency         String      @default("GBP")
  stripeSessionId  String?     @unique
  stripePaymentId  String?     @unique
  shippingName     String
  shippingEmail    String
  shippingAddress  String
  shippingCity     String
  shippingPostcode String
  orderedAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  bookId         String?
  titleSnapshot  String
  authorSnapshot String
  price          Decimal @db.Decimal(10, 2)
  quantity       Int     @default(1)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book         Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)
  libraryItems LibraryItem[]

  @@index([orderId])
  @@index([bookId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}

model Review {
  id               String       @id @default(cuid())
  userId           String
  bookId           String
  rating           Int
  comment          String
  status           ReviewStatus @default(PUBLISHED)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([status])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  chapterId String?
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([chapterId])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StripeWebhookEvent {
  eventId          String   @id
  eventType        String   @default("")
  paymentAttemptId String?
  processedAt      DateTime @default(now())

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([processedAt])
  @@index([paymentAttemptId])
}

model LibraryItem {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  orderItemId String?
  acquiredAt  DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([orderItemId])
}

model BookEdition {
  id        String   @id @default(cuid())
  bookId    String
  name      String   @default("First edition")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book  Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  files BookFile[]

  @@index([bookId])
}

model BookFile {
  id           String         @id @default(cuid())
  bookId       String
  editionId    String?
  storageKey   String         @default("")
  fileUrl      String
  fileType     BookFileType
  format       BookFileFormat
  originalName String
  contentType  String
  sizeBytes    Int
  isPublic     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  book    Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition BookEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@unique([bookId, fileType])
  @@index([bookId])
  @@index([editionId])
  @@index([fileType, isPublic])
}

model BookCover {
  id         String   @id @default(cuid())
  bookId     String   @unique
  storageKey String
  url        String
  ratio      String   @default("2:3")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           CartItem[]
  paymentAttempts PaymentAttempt[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  bookId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@index([bookId])
}

model PaymentAttempt {
  id                    String               @id @default(cuid())
  userId                String
  cartId                String?
  stripePaymentIntentId String?              @unique
  status                PaymentAttemptStatus @default(PENDING)
  amountCents           Int
  currency              String               @default("usd")
  shippingName          String
  shippingEmail         String
  shippingAddress       String
  shippingCity          String
  shippingPostcode      String
  failureMessage        String               @default("")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart   Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items  PaymentAttemptItem[]
  events StripeWebhookEvent[]

  @@index([userId, createdAt])
  @@index([cartId])
  @@index([status])
}

model PaymentAttemptItem {
  id               String @id @default(cuid())
  paymentAttemptId String
  bookId           String
  titleSnapshot    String
  authorSnapshot   String
  priceCents       Int
  quantity         Int

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  book           Book           @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([paymentAttemptId, bookId])
  @@index([bookId])
}

model ChapterRevision {
  id        String   @id @default(cuid())
  chapterId String
  userId    String
  title     String
  content   String
  isPreview Boolean
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([chapterId, createdAt])
  @@index([userId])
}
